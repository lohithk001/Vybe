# Root .gitignore for VYBE Monorepo

# Environment variables
.env
*.env
!.env.example

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/next-env.d.ts
frontend/.vercel
node_modules/
.next/

# Backend (Django / Python)
backend/venv/
backend/env/
backend/.venv/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
backend/db.sqlite3
backend/staticfiles/
backend/media/
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3

# Logs & System
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
*.pem
*.tsbuildinfo
