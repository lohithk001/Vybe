# ==========================================
# VYBE Backend Environment Configuration
# ==========================================

# Django Security
SECRET_KEY=django-insecure-change-this-to-a-high-entropy-random-string-in-production
DEBUG=True

# Hostnames & Routing
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (PostgreSQL on Neon / SQLite for local development)
# For local development with SQLite, leave as sqlite:///db.sqlite3
# For Neon Postgres: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Cache (Redis on Upstash / LocMemCache fallback for local dev)
# For Upstash Redis: rediss://default:your-token@your-endpoint.upstash.io:6379
# Leave empty to use local memory cache fallback in development
REDIS_URL=

# CORS Configuration
# Include your Vercel frontend domain, local dev, and Capacitor mobile origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,http://localhost
CORS_ALLOW_ALL_ORIGINS=False

# AI Engine (Phase 8 - Google Gemini)
GEMINI_API_KEY=
