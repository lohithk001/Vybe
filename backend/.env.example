# ==========================================
# VYBE Backend Environment Configuration
# ==========================================

# Django Environment & Settings
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-change-this-to-a-high-entropy-random-string-in-production
DEBUG=True

# Hostnames & Routing (Comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (PostgreSQL on Neon / SQLite for local development)
# For local dev: sqlite:///db.sqlite3
# For Neon Postgres: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Cache (Redis on Upstash / LocMemCache fallback for local dev)
# For Upstash Redis: rediss://default:your-token@your-endpoint.upstash.io:6379
# Leave empty to use local in-memory cache in development
REDIS_URL=

# CORS Configuration (Comma-separated allowed origins)
# Include your Vercel frontend domain, local dev ports, and Capacitor mobile origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,http://localhost
CORS_ALLOW_ALL_ORIGINS=False

# JWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google Gemini AI DJ Engine (Phase 8)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Port (Render sets this dynamically)
PORT=8000
